# EXEMPLO de segredos — este arquivo VAI para o repositório; o secrets.toml NÃO.
# Uso local:  copie para .streamlit/secrets.toml e preencha.
# No ar:      cole o conteúdo em "Edit secrets" no Streamlit Community Cloud.

# Desliga a verificação de TLS. Use SOMENTE em rede com proxy de inspeção
# (ex.: laboratório da escola). O padrão do app é seguro (true).
verificar_ssl = "true"

# Espaço reservado para as próximas etapas do bloco (LLMs, APIs com chave).
# CHAVE_API = ""
